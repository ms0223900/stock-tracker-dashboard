# 注意！ 不要修改此份 .env.example 檔案，這是範例檔案，請「複製此檔案」並「修改」為 .env.local 檔案。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LINE Messaging API（僅 server，勿使用 NEXT_PUBLIC_*）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# Vercel Cron：`Authorization: Bearer …` 與以下值一致；未設定則 `/api/cron/check-prices` 一律 401
CRON_SECRET=
